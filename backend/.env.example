# # ═══════════════════════════════════════════════
# # ✅ Server
# # ═══════════════════════════════════════════════
# PORT=4000
# NODE_ENV=development

# # ═══════════════════════════════════════════════
# # ✅ JWT
# # ═══════════════════════════════════════════════
# # ⚠️ این رو با یه رشته تصادفی طولانی عوض کن
# # مثلاً: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET=e2307e735a262f319ab01bd8907389335471109f78cd65ab60b12e4236da42e293bb5e28b89a7e15cdfc83b7bc561a444b911651013f24b80d924b5c5394406b
# JWT_EXPIRES_IN=30d
# JWT_REFRESH_EXPIRES_IN=90d

# # ═══════════════════════════════════════════════
# # ✅ Database
# # ═══════════════════════════════════════════════
# DB_PATH=./data/smart-planner.db

# # ═══════════════════════════════════════════════
# # ✅ CORS
# # ═══════════════════════════════════════════════
# CLIENT_URL=http://localhost:5173

# # ═══════════════════════════════════════════════
# # ✅ Rate Limiting
# # ═══════════════════════════════════════════════
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Database
DB_PATH=./data/smart-planner.db

# CORS
CORS_ORIGIN=http://localhost:5173
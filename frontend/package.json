{
  "name": "smart-planner",
  "private": true,
  "version": "2.0.0",
  "description": "برنامه‌ریزی هوشمند - Smart Planner | پلتفرم جامع مدیریت زمان و بهره‌وری",
  "author": "Smart Planner Team",
  "license": "MIT",
  "keywords": [
    "planner",
    "productivity",
    "todo",
    "tasks",
    "habits",
    "pomodoro",
    "notes",
    "kanban",
    "pwa",
    "react",
    "persian",
    "rtl"
  ],
  "homepage": "https://smart-planner.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/USERNAME/smart-planner.git"
  },
  "bugs": {
    "url": "https://github.com/USERNAME/smart-planner/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"front,back\" -c \"cyan,green\" \"npm run dev:front\" \"npm run dev:back\"",
    "dev:front": "vite",
    "dev:back": "cd backend && npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "backend:install": "cd backend && npm install",
    "backend:migrate": "cd backend && node src/db/migrate.js",
    "backend:migrate-sessions": "cd backend && node src/db/migrate-sessions.js",
    "setup": "npm install && npm run backend:install && npm run backend:migrate && npm run backend:migrate-sessions"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@reduxjs/toolkit": "^1.9.7",
    "@resvg/resvg-js": "^2.6.0",
    "@sentry/react": "^11.7.0",
    "@supabase/supabase-js": "^2.117.3",
    "date-fns": "^2.30.0",
    "dexie": "^4.4.6",
    "html2canvas": "^1.4.1",
    "i18next": "^23.5.1",
    "i18next-browser-languagedetector": "^7.1.0",
    "idb-keyval": "^6.3.0",
    "jalaali-js": "^1.2.7",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.284.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.47.0",
    "react-i18next": "^13.2.2",
    "react-icons": "^4.11.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.16.0",
    "react-toastify": "^9.1.3",
    "recharts": "^2.8.0",
    "redux-persist": "^6.0.0",
    "redux-undo": "^1.1.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.15",
    "cypress": "^13.2.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.29",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
